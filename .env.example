# Copy to .env and fill in the required values:
#   cp .env.example .env

# Secret key for signing session cookies.
# Local development reads this from .env; production injects it from Infisical.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Login password.
# Local development reads this from .env; production injects it from Infisical.
ECHO_PASSWORD=

# Username displayed in the interface.
# Default: katrin
ECHO_USERNAME=katrin

# Database URL.
# Default: sqlite:///echo.db in the project root.
# DATABASE_URL=sqlite:///echo.db

# Non-secret environment name. Controls the secure flag on the session cookie.
# Keep ENVIRONMENT=production in the production .env file.
# ENVIRONMENT=production
